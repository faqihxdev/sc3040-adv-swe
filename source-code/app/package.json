    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "node scripts/backup.mjs",
    "db:restore:practice": "node scripts/backup.mjs practice",
    "release:manifest": "node scripts/release-manifest.mjs",
    "db:start": "node scripts/local.mjs start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
